# Focal Deploy License Server Configuration

# Server Port
PORT=3100

# Encryption key for validation tokens (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=your-random-32-byte-hex-key-here

# Node Environment
NODE_ENV=development

# Production URL (update when deploying)
# LICENSE_SERVER_URL=https://license.focal-deploy.com
