# Focal Deploy SaaS Server Configuration

# Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/focal_deploy_saas
DB_HOST=localhost
DB_PORT=5432
DB_NAME=focal_deploy_saas
DB_USER=focal_deploy
DB_PASSWORD=your_secure_password_here

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY=your-32-byte-hex-encryption-key-change-this-in-production

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# AWS (for server-side operations)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Authorize.Net Payment Gateway
AUTHNET_API_LOGIN_ID=your_api_login_id
AUTHNET_TRANSACTION_KEY=your_transaction_key
AUTHNET_ENVIRONMENT=sandbox

# Email (for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@focuswithfocal.com

# Monitoring & Logging
LOG_LEVEL=info
SENTRY_DSN=

# Feature Flags
ENABLE_EULA_ENFORCEMENT=true
ENABLE_USAGE_TRACKING=true
ENABLE_BILLING=true

# Deployment
# Use .io domain for SaaS application (API and dashboard)
# Use .com domain for marketing website
DEPLOY_URL=https://api.focuswithfocal.io
DASHBOARD_URL=https://app.focuswithfocal.io
